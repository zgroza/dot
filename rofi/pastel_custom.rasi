* {
    font:               "AtkynsonMono Nerd Font Bold 10";

    /* Colors aligned with Waybar & SwayNC */
    background:         #000000;                   /* Pitch Black */
    background-alt:     #313244;                   /* Surface0 */
    foreground:         #cdd6f4;                   /* Text */
    selected:           #cba6f7;                   /* Mauve (Active) */
    selected-text:      #000000;                   /* Base (Contrast on Mauve) */
    border-col:         #FFFFFF1A;                 /* Subtle Border (White 10% opacity) */
    urgent:             #f38ba8;                   /* Red */
    active:             #89b4fa;                   /* Blue */

    /* General properties */
    background-color:   transparent;
    text-color:         @foreground;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    background-color:   @background;
    location:           center;
    width:              40%;
    border:             1px;
    border-color:       @border-col;
    border-radius:      20px;
    padding:            0.5em;
}

mainbox {
    children:   [ inputbar, listview ];
    spacing:    0.5em;
}

inputbar {
    children:           [ entry ];
    padding:            0.5em 1em;
    border-radius:      20px;
    background-color:   @background-alt;
    border:             1px;
    border-color:       @border-col;
}

entry, element-text, element-icon {
    vertical-align:     0.5;
    text-color:         inherit;
    placeholder-color:  @foreground;
}

listview {
    scrollbar:      false;
    columns:        1;
    rows:           12;
    spacing:        0.3em;
    fixed-height:   false;
    dynamic:        true;
    padding:        0.5em 0 0 0;
}

element {
    orientation:    horizontal;
    children:       [ element-icon, element-text ];
    spacing:        0.5em;
    padding:        0.5em 1em;
    border-radius:  20px;
    border:         1px;
    border-color:   transparent;
}

element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @foreground;
    border-color:       transparent;
}

element selected.normal,
element selected.active {
    background-color:   @selected;
    text-color:         @selected-text;
    border-color:       @selected;
}

element normal.urgent {
    background-color:   transparent;
    text-color:         @urgent;
}

element selected.urgent {
    background-color:   @urgent;
    text-color:         @selected-text;
}

element-icon {
    size:       1.2em;
    text-color: inherit;
}

element-text {
    text-color: inherit;
}
